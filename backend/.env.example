# VoiceApp Backend Environment Configuration
PROJECT_NAME=VoiceApp
VERSION=1.0.0
API_V1_STR=/api/v1

# Security Secrets (Generate a secure 64+ char random string for production)
JWT_SECRET=voiceapp_development_insecure_secret_key_change_in_prod_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Connection (PostgreSQL or local SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./voiceapp.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voiceapp

# Redis Connection (For transient session and room state)
REDIS_URL=redis://localhost:6379/0

# Speech Pipeline Configuration
PRIMARY_LANGUAGE=ml-IN
SECONDARY_LANGUAGE=ta-IN
